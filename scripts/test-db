#!/usr/bin/env bash
set -euo pipefail
exec docker run --rm --name kowari-test-pg \
  -p 127.0.0.1:55433:5432 \
  -e POSTGRES_USER=kowari \
  -e POSTGRES_PASSWORD=kowari \
  -e POSTGRES_DB=kowari \
  postgres:18.6 -c log_min_messages=warning \
  -c ssl=on \
  -c ssl_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem \
  -c ssl_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
