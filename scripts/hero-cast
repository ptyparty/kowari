#!/bin/bash

set -euo pipefail

cd "$(dirname "$0")/.."

CAST_DIR="${CAST_DIR:-/tmp/kowari-hero-cast}"
OUT="${1:-docs/kowari}"

mkdir -p "$CAST_DIR"
VENV="$CAST_DIR/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" -q install pyte pillow
fi

CONTAINER=kowari-hero-pg
PORT=55435

docker run -d --rm --name "$CONTAINER" -p "127.0.0.1:$PORT:5432" \
  -e POSTGRES_USER=shop -e POSTGRES_PASSWORD=shop -e POSTGRES_DB=shop \
  postgres:18.6 -c log_min_messages=warning >/dev/null
trap 'docker stop "$CONTAINER" >/dev/null' EXIT

until docker exec "$CONTAINER" psql -q -h 127.0.0.1 -U shop shop -c 'select 1' >/dev/null 2>&1; do sleep 0.5; done
docker exec -i "$CONTAINER" psql -q -v ON_ERROR_STOP=1 -h 127.0.0.1 -U shop shop < scripts/hero-fixture/seed.sql

PYTHONDONTWRITEBYTECODE=1 "$VENV/bin/python" scripts/lib/hero_cast.py "$OUT" "$PORT"
